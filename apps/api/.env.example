# PostgreSQL bağlantı dizesi (docker-compose.yml ile uyumlu)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/english_app?schema=public"

# Kimlik doğrulama (en az 32 karakter)
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Yapay zeka sağlayıcısı: auto | openai | gemini | mock
# auto: OPENAI_API_KEY varsa OpenAI, yoksa GEMINI_API_KEY, o da yoksa mock yanıtlar.
AI_PROVIDER="auto"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Oran sınırlama (geliştirmede kapatılabilir)
RATE_LIMIT_ENABLED="true"

# Entegrasyon testleri için ayrı bir veritabanı (npm run api:test bu değişkeni kullanır)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/english_app_test?schema=public"
