{
  "name": "proje-depom",
  "version": "0.1.0",
  "private": true,
  "description": "Uçtan uca İngilizce çalışma platformu (SRS, AI konuşma pratiği, okuyucu, analitik)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "api:typecheck": "npm run typecheck --workspace @proje-depom/api",
    "api:test": "npm run test --workspace @proje-depom/api",
    "db:generate": "npm run prisma:generate --workspace @proje-depom/api",
    "db:migrate": "npm run prisma:migrate --workspace @proje-depom/api",
    "db:seed": "npm run db:seed --workspace @proje-depom/api",
    "api:dev": "npm run dev --workspace @proje-depom/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:e2e",
    "mobile:start": "npm run start --workspace @proje-depom/mobile-web",
    "mobile:web": "npm run web --workspace @proje-depom/mobile-web",
    "mobile:export": "npm run export:web --workspace @proje-depom/mobile-web",
    "mobile:test": "npm run test --workspace @proje-depom/mobile-web",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "test:e2e": "playwright test",
    "android:apk": "bash scripts/build-android-apk.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  }
}
