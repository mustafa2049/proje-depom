{
  "name": "lexilearn",
  "private": true,
  "version": "1.0.0",
  "description": "LexiLearn \u2014 Leitner aral\u0131kl\u0131 tekrar sistemiyle \u0130ngilizce kelime \u00f6\u011frenme uygulamas\u0131",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:android": "tsc -b && CAPACITOR=1 vite build && cap sync android",
    "apk": "npm run build:android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
